<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.pbroman</groupId>
        <artifactId>brat-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>brat-cli</artifactId>
    <name>BRAT - command line</name>

    <!--
        The `brat` command: runs a suite from a terminal. A thin caller of brat-core - it maps flags
        onto a Launch and a RunResult onto an exit code, and decides nothing a run does.

        Depends on brat-core and picocli (plus commons-lang3, which core already brings), and is packaged as one self-contained jar
        (target/brat-cli.jar, `java -jar brat-cli.jar …`) by the shade plugin at `package`.
    -->

    <dependencies>
        <dependency>
            <groupId>dev.pbroman</groupId>
            <artifactId>brat-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <!-- Used directly; it also arrives through brat-core. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <!-- The jar's SLF4J binding: core logs through slf4j-api, and without a binding every warning
             is dropped. Runtime only - the command configures it through system properties. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>brat-cli</finalName>
                            <!-- The reduced POM is for publishing a shaded artifact, which this is not
                                 yet; left on, it writes dependency-reduced-pom.xml into the module. -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- Merges META-INF/services files rather than letting the last jar's
                                     copy win: core's registrations and any plugin's must all survive. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.pbroman.brat.cli.BratCli</mainClass>
                                    <manifestEntries>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <!-- A dependency's signature does not hold for a jar it was merged
                                     into, and a stale one makes the JVM refuse to load it; its
                                     module-info describes a module the merged jar is not. -->
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
