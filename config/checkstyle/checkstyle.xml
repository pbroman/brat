<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    BRAT checkstyle ruleset - the whole repo's, inherited by every module from brat-parent. Also
    usable from IntelliJ's CheckStyle-IDEA plugin (point it at this file).

    Scope: one ruleset for the whole repo, so modules cannot drift apart. Where a module genuinely
    needs an exception - brat-integration-tests hosts its server under test on Spring Boot - it is a
    suppression named below, scoped to the one package allowed to do it, rather than a second ruleset.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>

    <!-- Javadoc conventions are about brat-core's production types, not test classes - exempt src/test entirely
         rather than relying on IDE scope configuration. -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="MissingJavadocType|MissingJavadocMethod|JavadocMethod|SummaryJavadoc"/>
        <property name="files" value="[\\/]src[\\/]test[\\/]"/>
    </module>

    <!-- brat-integration-tests boots a Spring Boot application as the server a suite runs against.
         Exactly one package may import Spring: the one that defines and boots that application. The
         ban staying live everywhere else is what makes "Spring hosts the server, Spring does not wire
         BRAT" a build failure rather than a habit - an @Autowired runner in a test class cannot
         compile past it. Scoped by id so the other import bans still apply inside that package. -->
    <module name="SuppressionSingleFilter">
        <property name="id" value="frameworkImportBan"/>
        <property name="files" value="[\\/]brat-integration-tests[\\/].*[\\/]integration[\\/]app[\\/]"/>
    </module>

    <module name="LineLength">
        <property name="max" value="120"/>
        <!-- A long URL or a fully-qualified {@link} in Javadoc cannot be wrapped usefully. -->
        <property name="ignorePattern" value="^ *\* *([^ ]+|@see .*)$"/>
    </module>

    <!--
        "Never accumulate into a captured collection from forEach" (CLAUDE.md, "Other established
        conventions"). Written down after the pattern was removed three times and written fresh
        again; a 2026-08-11 sweep found four more instances, which is what moved it from a review
        target to a build gate - it is the kind of thing that is obvious in review and invisible
        while typing.

        Two forms, because they read differently: the one-liner `x.forEach(e -> result.add(e))` and
        the block `x.forEach((k, v) -> { ...; result.put(k, v); })`. Both are matched on the literal
        call, so a method reference (`list.forEach(other::add)`) and a stream that *collects* are
        deliberately untouched - collecting is the sanctioned alternative, not the problem.

        What this cannot catch: a `throw` trapped inside a forEach lambda, which is the other half of
        why the convention exists. That still needs review.
    -->
    <module name="RegexpMultiline">
        <property name="id" value="ForEachAccumulationInline"/>
        <property name="format" value="\.forEach\s*\([^;{}\n]*\.(add|addAll|put|putAll)\s*\("/>
        <property name="fileExtensions" value="java"/>
        <property name="message"
                  value="Do not accumulate into a captured collection from forEach - use a plain for loop over the collection, or a stream that collects. See CLAUDE.md, 'Other established conventions'."/>
    </module>
    <module name="RegexpMultiline">
        <property name="id" value="ForEachAccumulationBlock"/>
        <property name="format"
                  value="\.forEach\s*\((\([^)]*\)|\w+)\s*->\s*\{[^{}]*\.(add|addAll|put|putAll)\s*\("/>
        <property name="fileExtensions" value="java"/>
        <property name="message"
                  value="Do not accumulate into a captured collection from forEach - use a plain for loop over the collection, or a stream that collects. See CLAUDE.md, 'Other established conventions'."/>
    </module>

    <module name="TreeWalker">

        <!--
            Semantic rules only. Deliberately excluded: anything Spotless already fixes (unused
            imports, import order, whitespace) and anything SpotBugs detects better (equals/hashCode
            pairs, null dereferences) - three tools reporting one defect is how people learn to
            ignore all three.
        -->
        <module name="NeedBraces"/>
        <module name="EmptyCatchBlock"/>
        <module name="MissingSwitchDefault"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="HideUtilityClassConstructor"/>
        <module name="FinalClass"/>
        <module name="OneTopLevelClass"/>
        <module name="UnusedLocalVariable"/>


        <!-- "Every public or protected type ... gets a Javadoc block" -->
        <module name="MissingJavadocType">
            <property name="scope" value="protected"/>
        </module>

        <!-- "Every method on an api.* interface gets full contract documentation";
             "@Override implementations are undocumented by default" (Override is exempt by
             default); "Constructors are undocumented by default when ... self-evident" (the
             default minLineCount=2 skips trivial one-line bodies - a rough proxy only, expect
             some over-flagging on longer-but-still-simple constructors). -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="protected"/>
            <property name="allowedAnnotations" value="Override"/>
        </module>

        <!-- For whatever Javadoc *is* written: every actual parameter gets a matching @param,
             every non-void return gets @return - "Use @param/@return/@throws tags, not just
             prose." Unchecked-exception @throws (BratException et al.) isn't verified here -
             Checkstyle's own @throws validation targets declared/checked exceptions, which
             this codebase deliberately has none of (single-exception-type convention). -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public, protected"/>
            <property name="allowedAnnotations" value="Override"/>
        </module>

        <!-- "the first sentence states what the type/method is or does" - structural check
             only (a summary sentence exists and is well-formed), not a semantic one. -->
        <module name="SummaryJavadoc"/>

        <!-- Tags that exist must have actual descriptions, not "@param interpolation" with
             nothing after it. -->
        <module name="NonEmptyAtclauseDescription"/>

        <!-- "brat-core depends on nothing but the JDK and small, framework-neutral libraries
             ... Spring, Jakarta, or any DI/web framework - not fine" -->
        <module name="IllegalImport">
            <property name="id" value="frameworkImportBan"/>
            <property name="illegalPkgs" value="org.springframework, jakarta"/>
        </module>

        <!-- "String utils: org.apache.commons.lang3 only" -->
        <module name="IllegalImport">
            <property name="illegalClasses"
                      value="io.micrometer.common.util.StringUtils, org.apache.logging.log4j.util.Strings"/>
        </module>

        <!-- "AssertJ only for assertions - never JUnit Jupiter's Assertions..., never Hamcrest" -->
        <module name="IllegalImport">
            <property name="illegalClasses" value="org.junit.jupiter.api.Assertions"/>
            <property name="illegalPkgs" value="org.hamcrest"/>
        </module>

    </module>
</module>
