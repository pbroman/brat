<?xml version="1.0" encoding="UTF-8"?>
<!--
    The server under test boots on every module run; its startup log is not what anyone is reading
    here. BRAT's own output stays at INFO, since that is the thing under test.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="dev.pbroman.brat.core" level="INFO"/>
    <logger name="dev.pbroman.brat.integration" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
